<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing tokens and secrets must never leave the device (Android 12+ transfer rules) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
